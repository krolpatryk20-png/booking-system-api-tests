		{
			"name": "Create Booking",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"const jsonData = pm.response.json()\r",
							"\r",
							"pm.test(\"Status code is 200\" , () =>  {\r",
							"    pm.response.to.have.status(200);\r",
							"\r",
							"})\r",
							"\r",
							"\r",
							"if (jsonData.bookingid) {\r",
							"    \r",
							"    pm.collectionVariables.set(\"currentBookingId\", jsonData.bookingid); \r",
							"} else {\r",
							"    pm.expect.fail(\"currentBookingId not found in response\");\r",
							"}\r",
							"\r",
							"pm.test(\"Response contains a valid booking ID\", () => {\r",
							"    pm.expect(jsonData.bookingid).to.exist;\r",
							"});\r",
							"\r",
							"pm.test(\"Total price is greater than 0\", () => {\r",
							"    pm.expect(jsonData.booking.totalprice).to.be.above(0);\r",
							"});\r",
							"pm.test(\"Check-in date is before check-out date\", () => {\r",
							"    const checkin = new Date(jsonData.booking.bookingdates.checkin);\r",
							"    const checkout = new Date(jsonData.booking.bookingdates.checkout);\r",
							"\r",
							"    pm.expect(checkin.getTime()).to.be.below(checkout.getTime());\r",
							"});\r",
							"\r",
							"\r",
							"\r",
							"\r",
							"\r",
							"\r",
							"pm.test(\"Response time is less than 800ms\", () => {\r",
							"    pm.expect(pm.response.responseTime).to.be.below(800);\r",
							"});\r",
							""
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
			],
