		{
			"name": "Get Booking",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"const jsonData = pm.response.json();\r",
							"\r",
							"pm.test(\"Status code is 200\" , () =>  {\r",
							"    pm.response.to.have.status(200);\r",
							"\r",
							"});\r",
							"\r",
							"pm.test(\"Check Firstname is correct\", () => {\r",
							"    pm.expect(jsonData.firstname).to.eql(\"Patryk\")\r",
							"});\r",
							"\r",
							"pm.test(\"Data types are correct\", () => {\r",
							"    pm.expect(jsonData.firstname).to.be.a(\"string\")\r",
							"    pm.expect(jsonData.totalprice).to.be.a(\"number\")\r",
							"    pm.expect(jsonData.depositpaid).to.be.a(\"boolean\")\r",
							"    \r",
							"\r",
							"});\r",
							"pm.test(\"Total price is greater than 0\", () => {\r",
							"    pm.expect(jsonData.totalprice).to.be.above(0);\r",
							"});\r",
							"\r",
							"pm.test(\"Check-in date is before check-out date\", () => {\r",
							"    const checkin = new Date(jsonData.bookingdates.checkin);\r",
							"    const checkout = new Date(jsonData.bookingdates.checkout);\r",
							"\r",
							"    pm.expect(checkin.getTime()).to.be.below(checkout.getTime());\r",
							"});\r",
							"\r",
							"pm.test(\"Booking dates are present\", () => {\r",
							"    pm.expect(jsonData.bookingdates).to.have.property(\"checkin\");\r",
							"    pm.expect(jsonData.bookingdates).to.have.property(\"checkout\");\r",
							"});\r",
							"\r",
							"\r",
							"\r",
							"pm.test(\"Response time is less than 800ms\", () => {\r",
							"    pm.expect(pm.response.responseTime).to.be.below(800);\r",
							"});\r",
							""
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
